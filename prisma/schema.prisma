// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/* =======================
   ENUMS
======================= */

enum Nivel {
  Primario
  Secundario
}

enum PeriodoNombre {
  TRIMESTRE_1
  TRIMESTRE_2
  TRIMESTRE_3
  ANUAL
  CUATRIMESTRE_1
  CUATRIMESTRE_2
}

enum Turno {
  Mañana
  Tarde
}

enum EstadoAcademico {
  Activo
  Retirado
  Egresado
  Suspendido
}

enum TipoEvaluacion {
  Parcial
  Final
  Recuperatorio
}

enum EstadoAsistencia {
  Presente
  Ausente
  Tarde
  Justificado
}

enum EstadoCuota {
  Pendiente
  Parcial
  Pagado
  Vencido
}

enum TipoMovimientoStock {
  Entrada
  Salida
  Ajuste
}

enum CategoriaGasto {
  Mantenimiento
  Servicios
  Insumos
  Sueldos
}

/* =======================
   PERSONAS / USUARIOS
======================= */

model Persona {
  idPersona Int     @id @default(autoincrement())
  nombre    String
  apellido  String
  dni       String  @unique
  telefono  String?
  direccion String?
  email     String?

  usuario  Usuario?
  alumno   Alumno?
  profesor Profesor?
  padre    Padre?

  @@map("PERSONA")
}

model Usuario {
  idUsuario    Int      @id @default(autoincrement())
  idPersona    Int      @unique
  passwordHash String
  estado       Boolean
  createdAt    DateTime @default(now())

  persona Persona @relation(fields: [idPersona], references: [idPersona])
  roles   UsuarioRol[]

  pagos       Pago[]
  asistencias Asistencia[]
  comunicados Comunicado[]
  movimientos MovimientoStock[]
  gastos      GastoInstitucional[]

  @@map("USUARIO")
}

model Rol {
  idRol  Int    @id @default(autoincrement())
  nombre String @unique

  usuarios UsuarioRol[]

  @@map("ROL")
}

model UsuarioRol {
  idUsuario Int
  idRol     Int

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])
  rol     Rol     @relation(fields: [idRol], references: [idRol])

  @@id([idUsuario, idRol])
  @@map("USUARIO_ROL")
}

/* =======================
   ACTORES ACADÉMICOS
======================= */

model Alumno {
  idAlumno        Int      @id @default(autoincrement())
  idPersona       Int      @unique
  fechaNacimiento DateTime
  legajo          String   @unique

  persona    Persona     @relation(fields: [idPersona], references: [idPersona])
  matriculas Matricula[]
  padres     AlumnoPadre[]

  @@map("ALUMNO")
}

model Profesor {
  idProfesor   Int      @id @default(autoincrement())
  idPersona    Int      @unique
  fechaIngreso DateTime

  persona      Persona               @relation(fields: [idPersona], references: [idPersona])
  asignaciones AsignacionAcademica[]

  @@map("PROFESOR")
}

model Padre {
  idPadre   Int @id @default(autoincrement())
  idPersona Int @unique

  persona Persona       @relation(fields: [idPersona], references: [idPersona])
  alumnos AlumnoPadre[]

  @@map("PADRE")
}

model AlumnoPadre {
  idAlumno Int
  idPadre  Int
  relacion String

  alumno Alumno @relation(fields: [idAlumno], references: [idAlumno])
  padre  Padre  @relation(fields: [idPadre], references: [idPadre])

  @@id([idAlumno, idPadre])
  @@map("ALUMNO_PADRE")
}

/* =======================
   ESTRUCTURA ACADÉMICA
======================= */

model CicloLectivo {
  idCiclo Int  @id @default(autoincrement())
  anio    Int  @unique
  estado  Boolean

  periodos     PeriodoAcademico[]
  asignaciones AsignacionAcademica[]
  matriculas   Matricula[]

  @@map("CICLO_LECTIVO")
}

model PeriodoAcademico {
  idPeriodo   Int           @id @default(autoincrement())
  idCiclo     Int
  nombre      PeriodoNombre
  fechaInicio DateTime
  fechaFin    DateTime

  ciclo CicloLectivo @relation(fields: [idCiclo], references: [idCiclo])
  notas Nota[]

  @@unique([idCiclo, nombre])
  @@map("PERIODO_ACADEMICO")
}

model Curso {
  idCurso Int    @id @default(autoincrement())
  grado   String
  seccion String
  nivel   Nivel

  asignaciones AsignacionAcademica[]
  matriculas   Matricula[]

  @@map("CURSO")
}

model Materia {
  idMateria   Int    @id @default(autoincrement())
  nombre      String
  descripcion String?

  asignaciones AsignacionAcademica[]

  @@map("MATERIA")
}

model AsignacionAcademica {
  idAsignacion Int @id @default(autoincrement())
  idProfesor   Int
  idMateria    Int
  idCurso      Int
  idCiclo      Int
  cargaHoraria Int

  profesor Profesor @relation(fields: [idProfesor], references: [idProfesor])
  materia  Materia  @relation(fields: [idMateria], references: [idMateria])
  curso    Curso    @relation(fields: [idCurso], references: [idCurso])
  ciclo    CicloLectivo @relation(fields: [idCiclo], references: [idCiclo])

  horarios Horario[]
  notas    Nota[]

  @@unique([idMateria, idCurso, idCiclo])
  @@map("ASIGNACION_ACADEMICA")
}

model Horario {
  idHorario   Int      @id @default(autoincrement())
  idAsignacion Int
  diaSemana   String
  horaInicio  DateTime
  horaFin     DateTime
  turno       Turno
  aula        String?

  asignacion AsignacionAcademica @relation(fields: [idAsignacion], references: [idAsignacion])
  asistencias Asistencia[]

  @@map("HORARIO")
}

/* =======================
   MATRÍCULA / VIDA ACADÉMICA
======================= */

model Matricula {
  idMatricula       Int @id @default(autoincrement())
  idAlumno          Int
  idCurso           Int
  idCiclo           Int
  fechaInscripcion  DateTime
  estadoAcademico   EstadoAcademico
  promedioFinal     Float?

  alumno Alumno @relation(fields: [idAlumno], references: [idAlumno])
  curso  Curso  @relation(fields: [idCurso], references: [idCurso])
  ciclo  CicloLectivo @relation(fields: [idCiclo], references: [idCiclo])

  notas       Nota[]
  asistencias Asistencia[]
  cuotas      Cuota[]

  @@unique([idAlumno, idCiclo])
  @@map("MATRICULA")
}

model Nota {
  idNota       Int @id @default(autoincrement())
  idMatricula  Int
  idAsignacion Int
  idPeriodo    Int
  tipo         TipoEvaluacion
  nota         Float
  observacion  String?
  fechaRegistro DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  matricula  Matricula @relation(fields: [idMatricula], references: [idMatricula])
  asignacion AsignacionAcademica @relation(fields: [idAsignacion], references: [idAsignacion])
  periodo    PeriodoAcademico @relation(fields: [idPeriodo], references: [idPeriodo])

  @@map("NOTA")
}

model Asistencia {
  idAsistencia Int @id @default(autoincrement())
  idMatricula  Int
  idHorario    Int
  fecha        DateTime
  estado       EstadoAsistencia
  idUsuario    Int
  fechaRegistro DateTime

  matricula Matricula @relation(fields: [idMatricula], references: [idMatricula])
  horario   Horario   @relation(fields: [idHorario], references: [idHorario])
  usuario   Usuario   @relation(fields: [idUsuario], references: [idUsuario])

  @@map("ASISTENCIA")
}

/* =======================
   FINANZAS
======================= */

model Cuota {
  idCuota        Int @id @default(autoincrement())
  idMatricula    Int
  mes            Int
  montoOriginal  Float
  saldo          Float
  fechaVencimiento DateTime
  estado         EstadoCuota

  matricula Matricula @relation(fields: [idMatricula], references: [idMatricula])
  pagos     Pago[]

  @@unique([idMatricula, mes])
  @@map("CUOTA")
}

model Pago {
  idPago      Int @id @default(autoincrement())
  idCuota     Int
  fechaPago   DateTime
  monto       Float
  medioPago   String
  comprobante String?
  idUsuario   Int
  createdAt   DateTime @default(now())

  cuota   Cuota   @relation(fields: [idCuota], references: [idCuota])
  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])

  @@map("PAGO")
}

/* =======================
   COMUNICACIÓN
======================= */

model Comunicado {
  idComunicado Int @id @default(autoincrement())
  titulo       String
  contenido    String
  fecha        DateTime
  idUsuario    Int

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])

  @@map("COMUNICADO")
}

/* =======================
   INVENTARIO / GASTOS
======================= */

model Inventario {
  idInsumo      Int @id @default(autoincrement())
  nombre        String
  stockActual   Int
  stockMinimo   Int
  unidadMedida  String

  movimientos MovimientoStock[]

  @@map("INVENTARIO")
}

model MovimientoStock {
  idMovimiento Int @id @default(autoincrement())
  idInsumo     Int
  idUsuario    Int
  tipo         TipoMovimientoStock
  cantidad     Int
  fecha        DateTime

  insumo  Inventario @relation(fields: [idInsumo], references: [idInsumo])
  usuario Usuario    @relation(fields: [idUsuario], references: [idUsuario])
  gastos  GastoInstitucional[]

  @@map("MOVIMIENTO_STOCK")
}

model GastoInstitucional {
  idGasto      Int @id @default(autoincrement())
  idUsuario    Int
  monto        Float
  fecha        DateTime
  concepto     String
  categoria    CategoriaGasto
  idMovimiento Int?

  usuario    Usuario @relation(fields: [idUsuario], references: [idUsuario])
  movimiento MovimientoStock? @relation(fields: [idMovimiento], references: [idMovimiento])

  @@map("GASTO_INSTITUCIONAL")
}

