// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/**
 * =======================
 * ENUMS MODIFICADOS
 * =======================
 */

enum Nivel {
  Primario
  Secundario
}

enum PeriodoNombre {
  TRIMESTRE_1
  TRIMESTRE_2
  TRIMESTRE_3
  // CAMBIO: Agregamos las instancias de cierre de ciclo argentino
  DICIEMBRE
  FEBRERO
  JULIO_PREVIAS // Para alumnos que rinden materias de años anteriores
  ANUAL
}

enum Turno {
  Mañana
  Tarde
}

enum EstadoAcademico {
  Activo
  Retirado
  Egresado
  Suspendido
}

enum TipoEvaluacion {
  Parcial
  Recuperatorio
  EXAMEN_MESA
}

enum EstadoAsistencia {
  Presente
  Ausente
  Tarde
  Justificado
}

enum EstadoCuota {
  Pendiente
  Parcial
  Pagado
  Vencido
}

enum TipoMovimientoStock {
  Entrada
  Salida
  Ajuste
}

enum CategoriaGasto {
  Mantenimiento
  Servicios
  Insumos
  Sueldos
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA_DEBITO
  TARJETA_CREDITO
  OTRO
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

/**
 * =======================
 * PERSONAS / USUARIOS
 * =======================
 */

model Persona {
  idPersona Int     @id @default(autoincrement())
  nombre    String
  apellido  String
  dni       String  @unique
  telefono  String?
  direccion String?
  email     String?

  avatarUrl      String?
  avatarPublicId String?

  usuario  Usuario?
  alumno   Alumno?
  profesor Profesor?
  padre    Padre?

  @@map("PERSONA")
}

model Usuario {
  idUsuario    Int      @id @default(autoincrement())
  idPersona    Int      @unique
  passwordHash String
  estado       Boolean
  defaultPassword Boolean @default(true)
  createdAt    DateTime @default(now())

  persona           Persona              @relation(fields: [idPersona], references: [idPersona])
  roles             UsuarioRol[]
  pagosRegistrados  Pago[]               @relation("PagosRegistradosPorUsuario")
  asistencias       Asistencia[]
  comunicados       Comunicado[]         @relation("AutorComunicado")
  comunicadosVistos ComunicadoVisto[]    @relation("LectorComunicado")
  movimientos         MovimientoStock[]
  gastos              GastoInstitucional[]
  passwordResetTokens PasswordResetToken[]

  @@map("USUARIO")
}

model Rol {
  idRol  Int    @id @default(autoincrement())
  nombre String @unique

  usuarios UsuarioRol[]

  @@map("ROL")
}

model UsuarioRol {
  idUsuario Int
  idRol     Int

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])
  rol     Rol     @relation(fields: [idRol], references: [idRol])

  @@id([idUsuario, idRol])
  @@map("USUARIO_ROL")
}

/**
 * =======================
 * ACTORES ACADÉMICOS
 * =======================
 */

model Alumno {
  idAlumno        Int      @id @default(autoincrement())
  idPersona       Int      @unique
  fechaNacimiento DateTime
  legajo          String   @unique

  persona    Persona       @relation(fields: [idPersona], references: [idPersona])
  matriculas Matricula[]
  padres     AlumnoPadre[]
  cargos     Cargo[]
  pagos      Pago[]        @relation("PagosDelAlumno")

  @@map("ALUMNO")
}

model Profesor {
  idProfesor   Int      @id @default(autoincrement())
  idPersona    Int      @unique
  fechaIngreso DateTime

  persona      Persona               @relation(fields: [idPersona], references: [idPersona])
  asignaciones AsignacionAcademica[]

  @@map("PROFESOR")
}

model Padre {
  idPadre   Int @id @default(autoincrement())
  idPersona Int @unique

  persona Persona       @relation(fields: [idPersona], references: [idPersona])
  alumnos AlumnoPadre[]

  @@map("PADRE")
}

model AlumnoPadre {
  idAlumno Int
  idPadre  Int
  relacion String

  alumno Alumno @relation(fields: [idAlumno], references: [idAlumno])
  padre  Padre  @relation(fields: [idPadre], references: [idPadre])

  @@id([idAlumno, idPadre])
  @@map("ALUMNO_PADRE")
}

/**
 * =======================
 * ESTRUCTURA ACADÉMICA
 * =======================
 */

model CicloLectivo {
  idCiclo Int     @id @default(autoincrement())
  anio    Int     @unique
  estado  Boolean

  periodos     PeriodoAcademico[]
  asignaciones AsignacionAcademica[]
  matriculas   Matricula[]
  cargos       Cargo[]
  inventarios  Inventario[]

  @@map("CICLO_LECTIVO")
}

model PeriodoAcademico {
  idPeriodo   Int           @id @default(autoincrement())
  idCiclo     Int
  nombre      PeriodoNombre
  fechaInicio DateTime
  fechaFin    DateTime
  cerrado     Boolean       @default(false)

  ciclo CicloLectivo @relation(fields: [idCiclo], references: [idCiclo])
  notas Nota[]

  @@unique([idCiclo, nombre])
  @@map("PERIODO_ACADEMICO")
}

model Curso {
  idCurso Int    @id @default(autoincrement())
  grado   String
  seccion String
  nivel   Nivel
  turno   Turno

  asignaciones AsignacionAcademica[]
  matriculas   Matricula[]
  comunicados  Comunicado[]

  @@map("CURSO")
}

model Materia {
  idMateria   Int     @id @default(autoincrement())
  nombre      String
  descripcion String?

  asignaciones AsignacionAcademica[]

  @@map("MATERIA")
}

model AsignacionAcademica {
  idAsignacion Int     @id @default(autoincrement())
  idProfesor   Int?
  idMateria    Int
  idCurso      Int
  idCiclo      Int
  cargaHoraria Int
  estado       Boolean @default(true)
  motivoBaja   String?
  fechaBaja    DateTime?

  profesor Profesor?     @relation(fields: [idProfesor], references: [idProfesor])
  materia  Materia      @relation(fields: [idMateria], references: [idMateria])
  curso    Curso        @relation(fields: [idCurso], references: [idCurso])
  ciclo    CicloLectivo @relation(fields: [idCiclo], references: [idCiclo])

  horarios Horario[]
  notas    Nota[]

  @@map("ASIGNACION_ACADEMICA")
}

model Horario {
  idHorario    Int       @id @default(autoincrement())
  idAsignacion Int
  diaSemana    DiaSemana

  // Tip PRO: Usar String para horas recurrentes ("08:00")
  // evita problemas de zonas horarias que tiene el tipo DateTime
  horaInicio String
  horaFin    String
  aula       String?

  asignacion  AsignacionAcademica @relation(fields: [idAsignacion], references: [idAsignacion])
  asistencias Asistencia[]

  @@map("HORARIO")
}

/**
 * =======================
 * MATRÍCULA / VIDA ACADÉMICA
 * =======================
 */

model Matricula {
  idMatricula      Int             @id @default(autoincrement())
  idAlumno         Int
  idCurso          Int
  idCiclo          Int
  fechaInscripcion DateTime
  estadoAcademico  EstadoAcademico
  promedioFinal    Float?

  alumno Alumno       @relation(fields: [idAlumno], references: [idAlumno])
  curso  Curso        @relation(fields: [idCurso], references: [idCurso])
  ciclo  CicloLectivo @relation(fields: [idCiclo], references: [idCiclo])

  notas       Nota[]
  asistencias Asistencia[]

  // CORRECCIÓN: El alumno solo puede tener UNA matrícula por CICLO
  @@unique([idAlumno, idCiclo])
  @@map("MATRICULA")
}

model Nota {
  idNota        Int            @id @default(autoincrement())
  idMatricula   Int
  idAsignacion  Int
  idPeriodo     Int
  tipo          TipoEvaluacion
  nota          Float
  observacion   String?
  fechaRegistro DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  matricula  Matricula           @relation(fields: [idMatricula], references: [idMatricula])
  asignacion AsignacionAcademica @relation(fields: [idAsignacion], references: [idAsignacion])
  periodo    PeriodoAcademico    @relation(fields: [idPeriodo], references: [idPeriodo])

  @@map("NOTA")
}

model Asistencia {
  idAsistencia  Int              @id @default(autoincrement())
  idMatricula   Int
  idHorario     Int // <--- Cambiamos asignación por horario
  fecha         DateTime // Solo la fecha (ej: 2026-03-15)
  estado        EstadoAsistencia
  idUsuario     Int // Quién tomó lista (Preceptor o Docente)
  fechaRegistro DateTime         @default(now())

  matricula Matricula @relation(fields: [idMatricula], references: [idMatricula])
  horario   Horario   @relation(fields: [idHorario], references: [idHorario])
  usuario   Usuario   @relation(fields: [idUsuario], references: [idUsuario])

  // Esta línea es clave: evita que un alumno tenga dos asistencias en la misma clase el mismo día
  @@unique([idMatricula, idHorario, fecha])
  @@map("ASISTENCIA")
}

/**
 * =======================
 * FINANZAS
 * =======================
 */
model ConceptoDePago {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  montoFijo   Float?
  cargos      Cargo[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("CONCEPTO_PAGO")
}

model Cargo {
  id               Int            @id @default(autoincrement())
  alumnoId         Int
  alumno           Alumno         @relation(fields: [alumnoId], references: [idAlumno])
  conceptoId       Int
  concepto         ConceptoDePago @relation(fields: [conceptoId], references: [id])
  monto            Float
  fechaVencimiento DateTime
  estado           EstadoCuota    @default(Pendiente)

  cicloId Int?
  ciclo   CicloLectivo? @relation(fields: [cicloId], references: [idCiclo])

  pagoDetalles PagoDetalle[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("CARGO")
}

model Pago {
  id         Int        @id @default(autoincrement())
  alumnoId   Int
  alumno     Alumno     @relation("PagosDelAlumno", fields: [alumnoId], references: [idAlumno])
  montoTotal Float
  fechaPago  DateTime
  metodoPago MetodoPago
  referencia String?

  usuarioId Int // Who registered the payment
  usuario   Usuario @relation("PagosRegistradosPorUsuario", fields: [usuarioId], references: [idUsuario])

  detalles  PagoDetalle[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("PAGO")
}

model PagoDetalle {
  id      Int   @id @default(autoincrement())
  pagoId  Int
  pago    Pago  @relation(fields: [pagoId], references: [id])
  cargoId Int
  cargo   Cargo @relation(fields: [cargoId], references: [id])
  monto   Float // Amount of the payment applied to this specific cargo

  @@unique([pagoId, cargoId])
  @@map("PAGO_DETALLE")
}

model Comunicado {
  idComunicado Int      @id @default(autoincrement())
  titulo       String
  contenido    String
  fecha        DateTime @default(now())

  // Autor: Quién envía el mensaje (Admin o Docente)
  idUsuario Int
  usuario   Usuario @relation("AutorComunicado", fields: [idUsuario], references: [idUsuario])

  // Segmentación: A quién va dirigido
  // puede ser: "TODOS", "DOCENTES", "PADRES", "CURSO"
  target   String
  idTarget Int?
  curso    Curso? @relation(fields: [idTarget], references: [idCurso])

  // Seguimiento de lectura
  vistos ComunicadoVisto[]

  @@map("COMUNICADO")
}

model ComunicadoVisto {
  id           Int      @id @default(autoincrement())
  idComunicado Int
  idUsuario    Int
  fechaLectura DateTime @default(now())

  comunicado Comunicado @relation(fields: [idComunicado], references: [idComunicado])
  usuario    Usuario    @relation("LectorComunicado", fields: [idUsuario], references: [idUsuario])

  @@unique([idComunicado, idUsuario])
  @@map("COMUNICADO_VISTO")
}

model Inventario {
  idInsumo     Int    @id @default(autoincrement())
  idCiclo      Int?
  nombre       String
  stockActual  Int
  stockMinimo  Int
  unidadMedida String

  ciclo       CicloLectivo?     @relation(fields: [idCiclo], references: [idCiclo])
  movimientos MovimientoStock[]

  @@map("INVENTARIO")
}

model MovimientoStock {
  idMovimiento Int                 @id @default(autoincrement())
  idInsumo     Int
  idUsuario    Int
  tipo         TipoMovimientoStock
  cantidad     Int
  fecha        DateTime

  insumo  Inventario           @relation(fields: [idInsumo], references: [idInsumo])
  usuario Usuario              @relation(fields: [idUsuario], references: [idUsuario])
  gastos  GastoInstitucional[]

  @@map("MOVIMIENTO_STOCK")
}

model GastoInstitucional {
  idGasto      Int            @id @default(autoincrement())
  idUsuario    Int
  monto        Float
  fecha        DateTime
  concepto     String
  categoria    CategoriaGasto
  idMovimiento Int?

  usuario    Usuario          @relation(fields: [idUsuario], references: [idUsuario])
  movimiento MovimientoStock? @relation(fields: [idMovimiento], references: [idMovimiento])

  @@map("GASTO_INSTITUCIONAL")
}

model BloqueHorario {
  id         Int    @id @default(autoincrement())
  turno      Turno
  horaInicio String
  horaFin    String
  orden      Int

  @@unique([turno, orden])
  @@map("BLOQUE_HORARIO")
}

model DiaHabil {
  id         Int      @id @default(autoincrement())
  nombre     DiaSemana @unique
  habilitado Boolean  @default(true)
  orden      Int

  @@unique([orden])
  @@map("DIA_HABIL")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expires   DateTime
  userId    Int
  user      Usuario  @relation(fields: [userId], references: [idUsuario], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}
